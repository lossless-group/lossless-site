---
/**
 * One Open Spec as an image card. Published specs are links; unpublished ones
 * are buttons that raise the "not yet developed" toast (see SpecToast.astro).
 */
import type { SpecCardData } from '@utils/openSpecs';

interface Props {
  spec: SpecCardData;
}

const { spec } = Astro.props;
const Tag = spec.published ? 'a' : 'button';
const attrs = spec.published
  ? { href: spec.href }
  : { type: 'button', 'data-spec-teaser': spec.id, 'aria-label': `${spec.title} (not yet developed)` };
const statusClass = `status--${spec.status.toLowerCase().replace(/[^a-z]+/g, '-')}`;
---

<Tag
  class:list={['spec-card', { 'spec-card--teaser': !spec.published }]}
  data-status={spec.status}
  data-published={spec.published ? 'true' : 'false'}
  {...attrs}
>
  <div class="spec-card__media">
    {spec.image ? (
      <img src={spec.image} alt="" loading="lazy" decoding="async" />
    ) : (
      <div class="spec-card__fallback" aria-hidden="true"><span>{spec.title}</span></div>
    )}
    {!spec.published && <span class="spec-card__ribbon">In the works</span>}
  </div>
  <div class="spec-card__body">
    <span class:list={['spec-card__status', statusClass]}>{spec.status}</span>
    <h3 class="spec-card__title">{spec.title}</h3>
    {spec.lede && <p class="spec-card__lede">{spec.lede}</p>}
  </div>
</Tag>

<style>
  .spec-card {
    display: flex;
    flex-direction: column;
    text-align: left;
    font: inherit;
    color: var(--clr-lossless-primary-light, #e6e6e6);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.75rem;
    overflow: hidden;
    padding: 0;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
    height: 100%;
  }
  .spec-card:hover,
  .spec-card:focus-visible {
    transform: translateY(-3px);
    border-color: var(--clr-lossless-accent--brightest, #7df9ff);
    background: rgba(255, 255, 255, 0.07);
  }
  .spec-card:focus-visible {
    outline: 2px solid var(--clr-lossless-accent--brightest, #7df9ff);
    outline-offset: 2px;
  }

  .spec-card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #111;
  }
  .spec-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease, filter 0.3s ease;
  }
  .spec-card:hover .spec-card__media img {
    transform: scale(1.04);
  }
  .spec-card__fallback {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background: linear-gradient(135deg, #1b2a4a 0%, #3a1c5c 55%, #0f4c5c 100%);
  }
  .spec-card__fallback span {
    font-size: 1.25rem;
    font-weight: 700;
    text-align: center;
    color: rgba(255, 255, 255, 0.85);
  }

  .spec-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.9rem 1rem 1.1rem;
  }
  .spec-card__title {
    margin: 0;
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.3;
    color: var(--clr-lossless-accent--brightest, #7df9ff);
  }
  .spec-card__lede {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--clr-lossless-primary-light-alt, #bbb);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .spec-card__status {
    align-self: flex-start;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    color: #ddd;
  }
  .status--idea { background: rgba(167, 139, 250, 0.2); color: #c4b5fd; }
  .status--stub { background: rgba(148, 163, 184, 0.2); color: #cbd5e1; }
  .status--draft { background: rgba(251, 191, 36, 0.18); color: #fcd34d; }
  .status--proposed { background: rgba(56, 189, 248, 0.18); color: #7dd3fc; }
  .status--iterating { background: rgba(52, 211, 153, 0.18); color: #6ee7b7; }

  /* Unpublished: visible, dimmed, never a link */
  .spec-card--teaser .spec-card__media img {
    filter: grayscale(0.7) brightness(0.65);
  }
  .spec-card--teaser:hover .spec-card__media img {
    filter: grayscale(0.3) brightness(0.8);
  }
  .spec-card--teaser .spec-card__title {
    color: var(--clr-lossless-primary-light, #e6e6e6);
  }
  .spec-card__ribbon {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
    border-radius: 0.35rem;
    background: rgba(0, 0, 0, 0.7);
    color: #fff;
    backdrop-filter: blur(4px);
  }
</style>
