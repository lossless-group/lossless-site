---
interface Item {
  href: string;
  title: string;
  description: string;
  // Opens in a new tab. Used for standalone static pages (e.g. the graphify
  // viewer at /graph.html) that aren't part of the Astro route tree.
  external?: boolean;
  // Renders as a solid button at the top of the dropdown.
  primary?: boolean;
  // Optional logo shown on the primary button.
  icon?: string;
}

interface Props {
  label: string;
  items: Item[];
  // Render non-primary items as small title-only links instead of large cards.
  compact?: boolean;
}

const { label, items, compact = false } = Astro.props;

const linkAttrs = (item: Item) => ({
  target: item.external ? "_blank" : undefined,
  rel: item.external ? "noopener noreferrer" : undefined,
});
---

<div class="dropdown-wrapper">
  <button class="dropdown-trigger">{label}</button>
  <div class={`jumbo-dropdown${compact ? " jumbo-dropdown--compact" : ""}`}>
    {items.map((item) =>
      item.primary ? (
        <a href={item.href} class="jumbo-dropdown-primary" {...linkAttrs(item)}>
          {item.icon && <img class="primary-icon" src={item.icon} alt="" width="40" height="40" />}
          <span class="primary-text">
            <span class="primary-title">{item.title} <span aria-hidden="true">→</span></span>
            <span class="primary-description">{item.description}</span>
          </span>
        </a>
      ) : compact ? (
        <a href={item.href} class="jumbo-dropdown-compact" title={item.description} {...linkAttrs(item)}>
          {item.title}
        </a>
      ) : (
        <a href={item.href} class="jumbo-dropdown-item" {...linkAttrs(item)}>
          <div class="item-title">{item.title}</div>
          <div class="item-description">{item.description}</div>
        </a>
      )
    )}
  </div>
</div>


<style>
.dropdown-wrapper {
  position: relative;
  font-family: "Poppins", sans-serif;
  display: inline-block;
}

.dropdown-trigger {
  all: unset;
  display: inline-block;
  color: var(--clr-lossless-primary-light);
  font-family: "Poppins", sans-serif;
  font-size: clamp(0.9em, 1.1vw, 1.25em);
  line-height: 1.2;
  white-space: nowrap;
  transition: font-size 0.3s ease, color 0.2s ease;
  text-decoration: none;
  font-weight: normal;
  cursor: pointer;
}

.jumbo-dropdown {
  display: flex;
  position: absolute;
  top: 100%;
  left: 0;
  background-color: var(--clr-primary-bg);
  padding: 1rem;
  padding-top: 0.75rem;
  margin-top: 0.5rem;
  gap: 1.5rem;
  border-radius: 0.5rem;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
  z-index: 1002;
  min-width: 400px;
  flex-direction: column;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 0.2s ease, visibility 0.2s ease;
  will-change: opacity;
}

/* Bridge element to maintain hover state */
.jumbo-dropdown::before {
  content: '';
  position: absolute;
  top: -0.5rem;
  left: 0;
  right: 0;
  height: 0.5rem;
  background: transparent;
}

.dropdown-wrapper:hover .jumbo-dropdown {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

.jumbo-dropdown-item {
  display: block;
  width: 100%;
  text-decoration: none;
  color: var(--clr-lossless-primary-light);
  background-color: rgba(255, 255, 255, 0.03);
  padding: 1rem;
  border-radius: 0.5rem;
  transition: background-color 0.2s ease;
}

.jumbo-dropdown-item:hover {
  background-color: rgba(255, 255, 255, 0.08);
}

.item-title {
  font-weight: bold;
  font-size: 1.1rem;
  margin-bottom: 0.25rem;
}

.item-description {
  font-size: 0.9rem;
  color: var(--clr-lossless-primary-light-alt, #ccc);
}

/* Primary item: a solid button */
.jumbo-dropdown-primary {
  display: flex;
  align-items: center;
  gap: 0.9rem;
  text-decoration: none;
  padding: 1rem 1.25rem;
  margin-bottom: 0.75rem;
  border-radius: 0.6rem;
  background-color: var(--clr-lossless-accent--brightest, #3fe0d0);
  color: var(--clr-primary-bg, #111);
  transition: filter 0.2s ease, transform 0.2s ease;
}

.primary-icon {
  flex-shrink: 0;
  width: 2.5rem;
  height: 2.5rem;
  padding: 0.35rem;
  border-radius: 0.5rem;
  background-color: var(--clr-primary-bg, #111);
}

.primary-text {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
}

.primary-title {
  font-weight: 700;
  font-size: 1.2rem;
  white-space: nowrap;
}

.primary-description {
  font-size: 0.8rem;
  line-height: 1.3;
  opacity: 0.85;
}

.jumbo-dropdown-primary:hover {
  filter: brightness(1.1);
  transform: translateY(-1px);
}

/* Compact variant: a short list of small links */
.jumbo-dropdown--compact {
  min-width: 320px;
  gap: 0.1rem;
  padding: 0.5rem;
}

.jumbo-dropdown-compact {
  font-size: 0.85rem;
  color: var(--clr-lossless-primary-light-alt, #ccc);
  text-decoration: none;
  white-space: nowrap;
  padding: 0.35rem 0.6rem;
  border-radius: 0.35rem;
  transition: background-color 0.2s ease, color 0.2s ease;
}

.jumbo-dropdown-compact:hover {
  background-color: rgba(255, 255, 255, 0.06);
  color: var(--clr-lossless-primary-light);
}
</style>
