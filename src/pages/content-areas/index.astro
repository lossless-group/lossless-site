---
/**
 * /content-areas/index.astro — Index page for the content-areas collection.
 *
 * Two-level filtering (area → sub-folder) with live counts and a word total via FolderTabs.
 * Entries with an og_image render as ToolCards (listed first, as in CardGrid); everything
 * else renders as CollectionPreviewCard with word count and version.
 * Titles are title → filename; an organization's og_title is a subtitle under its name, never the title.
 * No frontmatter is required: stubs render with a filename title and no badges.
 */
import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getReferenceSlug } from '@utils/slugify';
import { countWordsInMarkdown } from '@utils/fileWordCount';
import { originalSegments, getDisplayTitle, folderLabel } from '@utils/collectionEntryDisplay';
import FolderTabs, { type FolderTab } from '@components/reference/FolderTabs.astro';
import CollectionPreviewCard from '@components/reference/CollectionPreviewCard.astro';
import ToolCard from '@components/tool-components/ToolCard.astro';
import WordCountDisplay from '@components/basics/WordCountDisplay.astro';

const BASE = 'content-areas';
const ROOT_TYPE = '_root';

const entries = await getCollection('content-areas');

const asString = (v: unknown) => (typeof v === 'string' && v.trim() ? v.trim() : undefined);
const asTags = (v: unknown): string[] =>
  Array.isArray(v) ? v.filter((t): t is string => typeof t === 'string') : typeof v === 'string' ? [v] : [];

const items = entries.map(entry => {
  const segs = originalSegments(entry, BASE);
  const idSegs = entry.id.split('/');
  const nested = segs.length > 1;
  const area = nested ? idSegs[0] : 'root';
  const type = segs.length > 2 ? idSegs[1] : ROOT_TYPE;
  const title = getDisplayTitle({ ...entry, data: { ...entry.data, og_title: undefined } }, BASE);
  const ogTitle = asString(entry.data?.og_title);
  const ogImage = asString(entry.data?.og_image);
  const rawVersion = entry.data?.at_semantic_version;
  return {
    entry,
    area,
    areaLabel: nested ? folderLabel(segs[0]) : 'Uncategorized',
    type,
    typeLabel: type === ROOT_TYPE ? 'Overview & Other' : folderLabel(segs[1]),
    title,
    subtitle: type === 'organizations' && ogTitle && ogTitle !== title ? ogTitle : undefined,
    href: `/content-areas/${getReferenceSlug(entry.id)}`,
    words: countWordsInMarkdown(entry.body || ''),
    version: rawVersion != null && String(rawVersion).trim() ? String(rawVersion).trim() : undefined,
    image: ogImage && /^https?:\/\//.test(ogImage) ? ogImage : undefined,
    isReadme: segs[segs.length - 1].toLowerCase() === 'readme',
  };
});

// Image cards first (as in CardGrid), area READMEs first among the rest, then by title
items.sort((a, b) =>
  Number(!!b.image) - Number(!!a.image) ||
  Number(b.isReadme) - Number(a.isReadme) ||
  a.title.localeCompare(b.title)
);

const totalWords = items.reduce((sum, i) => sum + i.words, 0);

// Level 1: areas, alphabetical, "Uncategorized" last
const areaMap = new Map<string, FolderTab>();
for (const i of items) {
  const t = areaMap.get(i.area) ?? { id: i.area, label: i.areaLabel, count: 0 };
  t.count++;
  areaMap.set(i.area, t);
}
const levelOne = [...areaMap.values()].sort((a, b) =>
  Number(a.id === 'root') - Number(b.id === 'root') || a.label.localeCompare(b.label)
);

// Level 2: sub-folders per area, plus an "all" row grouping the same sub-folder across areas.
// Organizations and Concepts first, "Overview & Other" last, the rest alphabetical.
const PRIORITY = ['organizations', 'concepts'];
const typeOrder = (t: FolderTab) =>
  t.id === ROOT_TYPE ? 99 : PRIORITY.includes(t.id) ? PRIORITY.indexOf(t.id) : 10;
const sortTypes = (tabs: FolderTab[]) =>
  tabs.sort((a, b) => typeOrder(a) - typeOrder(b) || a.label.localeCompare(b.label));

const levelTwoMaps: Record<string, Map<string, FolderTab>> = { all: new Map() };
for (const i of items) {
  for (const parent of [i.area, 'all']) {
    const m = (levelTwoMaps[parent] ??= new Map());
    const t = m.get(i.type) ?? { id: i.type, label: i.typeLabel, count: 0 };
    t.count++;
    m.set(i.type, t);
  }
}
const levelTwo: Record<string, FolderTab[]> = {};
for (const [parent, m] of Object.entries(levelTwoMaps)) {
  const tabs = sortTypes([...m.values()]);
  if (tabs.length > 1) levelTwo[parent] = tabs; // a single sub-folder adds nothing to filter by
}
---

<Layout
  title="Content Areas"
  description="Domain content areas: organizations, concepts, issues, and vocabulary by industry and cause"
  frontmatter={{
    title: "Content Areas",
    description: "Domain content areas: organizations, concepts, issues, and vocabulary by industry and cause"
  }}
>
  <div class="areas-container">
    <header class="areas-header">
      <h1>Content Areas</h1>
      <p class="description">
        Our domain content areas: the organizations, concepts, issues, and vocabulary of an industry or cause.
      </p>
    </header>

    <FolderTabs
      gridId="areas-grid"
      levelOne={levelOne}
      levelTwo={levelTwo}
      totalCount={items.length}
      totalWords={totalWords}
    />

    <div id="areas-grid" class="areas-grid">
      {items.map(item => (
        <div
          class={`areas-item${item.image ? ' areas-item--image' : ''}`}
          data-area={item.area}
          data-type={item.type}
          data-words={item.words}
        >
          {item.image ? (
            <>
              <ToolCard
                id={item.entry.id}
                url={asString(item.entry.data?.url)}
                og_image={item.image}
                site_name={item.title}
                title={item.subtitle}
                description={asString(item.entry.data?.description)}
                og_description={asString(item.entry.data?.og_description)}
                tags={asTags(item.entry.data?.tags)}
                filename={item.title}
                detailHref={item.href}
                keepNameCase
              />
              <div class="areas-item__badges">
                <span>{item.areaLabel} · {item.typeLabel}</span>
                <span class="areas-item__stats">
                  {item.words > 90 && <WordCountDisplay count={item.words} className="text-gray-400" showIcon={false} />}
                  {item.version && <span class="areas-item__version">{item.version}</span>}
                </span>
              </div>
            </>
          ) : (
            <CollectionPreviewCard
              href={item.href}
              title={item.title}
              subtitle={item.subtitle}
              meta={item.area === 'root' ? undefined : `${item.areaLabel} · ${item.typeLabel}`}
              wordCount={item.words}
              version={item.version}
            />
          )}
        </div>
      ))}
    </div>

    <div class="empty-state" data-empty-state hidden>
      <p>No pages in this folder.</p>
    </div>
  </div>
</Layout>

<style>
  .areas-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem;
  }

  .areas-header {
    margin-bottom: 1.5rem;
  }

  .areas-header h1 {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--clr-lossless-primary-light, #fff);
    margin-bottom: 0.5rem;
  }

  .description {
    font-size: 1.125rem;
    color: var(--clr-body, rgba(255, 255, 255, 0.8));
    margin: 0;
  }

  .areas-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
    align-items: start;
  }

  .areas-item[hidden],
  .empty-state[hidden] {
    display: none;
  }

  .areas-item__badges {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.35rem;
    padding: 0 0.25rem;
    font-size: 0.75rem;
    color: var(--white--pure--40p, rgba(255, 255, 255, 0.4));
  }

  .areas-item__stats {
    display: inline-flex;
    gap: 0.5rem;
    white-space: nowrap;
  }

  .areas-item__version {
    font-size: 0.7rem;
    opacity: 0.8;
  }

  .empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--clr-body, rgba(255, 255, 255, 0.6));
  }

  @media (max-width: 768px) {
    .areas-container { padding: 1rem; }
    .areas-header h1 { font-size: 2rem; }
    .areas-grid { grid-template-columns: 1fr; }
  }
</style>
