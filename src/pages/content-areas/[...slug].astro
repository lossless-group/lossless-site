---
/**
 * /content-areas/[...slug].astro — Dynamic route for the content-areas collection.
 * No frontmatter requirements; preserved folder structure in URLs (/content-areas/<area>/<type>/<entry>).
 * Title is title → filename. og_title is never the title: on organizations it renders as a
 * subtitle under the name.
 */
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import OneArticle from '@layouts/OneArticle.astro';
import OneArticleOnPage from '@components/articles/OneArticleOnPage.astro';
import { getReferenceSlug } from '@utils/slugify';
import { originalSegments, getDisplayTitle } from '@utils/collectionEntryDisplay';

export const prerender = true;

export async function getStaticPaths() {
  const areaEntries = await getCollection('content-areas');
  const paths: any[] = [];
  const errors: { id: string; error: string }[] = [];

  console.log(`[CONTENT-AREAS] Found ${areaEntries.length} entries in the content-areas collection`);

  for (const entry of areaEntries) {
    try {
      const slug = getReferenceSlug(entry.id);
      // og_title is a tagline, not a name: drop it from the title chain
      const title = getDisplayTitle({ ...entry, data: { ...entry.data, og_title: undefined } }, 'content-areas');
      const folder = entry.id.includes('/') ? entry.id.split('/')[0] : 'root';
      const segs = originalSegments(entry, 'content-areas');
      const isOrganization = segs.length > 2 && segs[1].toLowerCase() === 'organizations';
      const ogTitle = typeof entry.data?.og_title === 'string' ? entry.data.og_title.trim() : '';
      const subtitle = isOrganization && ogTitle && ogTitle !== title ? ogTitle : undefined;

      paths.push({
        params: { slug },
        props: {
          entry: {
            ...entry,
            data: {
              ...entry.data,
              title,
            }
          },
          folder,
          subtitle
        }
      });
    } catch (error) {
      const errorMessage = error instanceof Error ? error.message : String(error);
      console.warn(`[CONTENT-AREAS] Skipping ${entry.id}: ${errorMessage}`);
      errors.push({ id: entry.id, error: errorMessage });
    }
  }

  if (errors.length > 0) {
    console.warn(`[CONTENT-AREAS] ${errors.length} entries skipped due to errors`);
  }
  console.log(`[CONTENT-AREAS] Generated ${paths.length} content-area paths`);
  return paths;
}

interface Props {
  entry: {
    id: string;
    body?: string;
    data: {
      title: string;
      og_title?: string;
      url?: string;
      tags?: string | string[];
      [key: string]: any;
    };
  };
  folder: string;
  subtitle?: string;
}

const { entry, folder, subtitle } = Astro.props;

const contentData = {
  path: Astro.url.pathname,
  id: entry.id,
  title: entry.data.title,
  contentType: 'content-areas',
  folder,
  subtitle
};
---

<Layout
  title={entry.data.title}
  frontmatter={entry.data}
>
  <OneArticle
    Component={OneArticleOnPage}
    title={entry.data.title}
    content={entry.body || ''}
    markdownFile={entry.id}
    data={contentData}
  />
</Layout>
