---
/**
 * Tag MOC Index Page
 * Lists all available tag-based Maps of Content
 */
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';

export const prerender = true;

// Get all published tag MOCs
const tagMocs = await getCollection('tag-mocs', ({ data }) => data.publish !== false);

// Sort by title
tagMocs.sort((a, b) => a.data.title.localeCompare(b.data.title));

// Count total items for each MOC
const mocsWithCounts = await Promise.all(
  tagMocs.map(async (moc) => {
    const tag = moc.data.tag;

    const [tooling, verticalToolkits, essays, concepts, vocabulary, projects] = await Promise.all([
      getCollection('tooling', ({ data }) => data.tags?.includes(tag)),
      getCollection('vertical-toolkits', ({ data }) => data.tags?.includes(tag)),
      getCollection('essays', ({ data }) => data.tags?.includes(tag)),
      getCollection('concepts', ({ data }) => data.tags?.includes(tag)),
      getCollection('vocabulary', ({ data }) => data.tags?.includes(tag)),
      getCollection('projects', ({ data }) => data.tags?.includes(tag) && data.publish !== false),
    ]);

    const toolCount = tooling.length + verticalToolkits.length;
    const articleCount = essays.length + concepts.length + vocabulary.length;
    const totalCount = toolCount + articleCount + projects.length;

    return {
      moc,
      toolCount,
      articleCount,
      projectCount: projects.length,
      totalCount
    };
  })
);
---

<Layout title="Tag Maps of Content">
  <div class="moc-index-page">
    <header class="moc-index-header">
      <h1>Tag Maps of Content</h1>
      <p class="subtitle">
        Explore curated collections of tools, articles, and resources organized by topic
      </p>
      <div class="moc-stats">
        <span><strong>{tagMocs.length}</strong> topic maps</span>
        <span><strong>{mocsWithCounts.reduce((sum, m) => sum + m.totalCount, 0)}</strong> total items</span>
      </div>
    </header>

    <div class="moc-grid">
      {mocsWithCounts.map(({ moc, toolCount, articleCount, projectCount, totalCount }) => (
        <a href={`/moc/tag/${moc.id}`} class="moc-card">
          {moc.data.banner_image && (
            <div class="moc-card-image" style={`background-image: url('${moc.data.banner_image}')`}></div>
          )}
          <div class="moc-card-content">
            <h2>{moc.data.title}</h2>
            {moc.data.description && (
              <p class="moc-description">{moc.data.description}</p>
            )}
            <div class="moc-card-stats">
              <span class="stat">
                <span class="stat-number">{totalCount}</span>
                <span class="stat-label">items</span>
              </span>
              {toolCount > 0 && (
                <span class="stat">
                  <span class="stat-number">{toolCount}</span>
                  <span class="stat-label">tools</span>
                </span>
              )}
              {articleCount > 0 && (
                <span class="stat">
                  <span class="stat-number">{articleCount}</span>
                  <span class="stat-label">articles</span>
                </span>
              )}
              {projectCount > 0 && (
                <span class="stat">
                  <span class="stat-number">{projectCount}</span>
                  <span class="stat-label">projects</span>
                </span>
              )}
            </div>
            {moc.data.related_tags && moc.data.related_tags.length > 0 && (
              <div class="related-tags-preview">
                <span class="related-label">Related:</span>
                {moc.data.related_tags.slice(0, 3).map((tag: string) => (
                  <span class="tag-badge">{tag}</span>
                ))}
                {moc.data.related_tags.length > 3 && (
                  <span class="tag-badge">+{moc.data.related_tags.length - 3}</span>
                )}
              </div>
            )}
          </div>
        </a>
      ))}
    </div>

    {tagMocs.length === 0 && (
      <div class="empty-state">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
          <path d="M9 12h6m-6 4h6" />
        </svg>
        <h2>No Tag MOCs Found</h2>
        <p>Tag-based Maps of Content will appear here once they're created.</p>
      </div>
    )}
  </div>
</Layout>

<style>
  .moc-index-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem;
  }

  .moc-index-header {
    margin-bottom: 3rem;
    text-align: center;
    border-bottom: 2px solid var(--clr-lossless-accent--brightest);
    padding-bottom: 2rem;
  }

  .moc-index-header h1 {
    font-size: 3rem;
    margin: 0 0 1rem 0;
    color: var(--clr-lossless-accent--brightest);
  }

  .subtitle {
    font-size: 1.25rem;
    color: var(--clr-lossless-primary-light);
    margin: 0 0 1.5rem 0;
    opacity: 0.9;
  }

  .moc-stats {
    display: flex;
    gap: 2rem;
    justify-content: center;
    font-size: 1.1rem;
    color: var(--clr-lossless-primary-light);
  }

  .moc-stats strong {
    color: var(--clr-lossless-accent--aquamarine);
    font-size: 1.3rem;
  }

  /* MOC Grid */
  .moc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 2rem;
  }

  .moc-card {
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.03);
    border: 2px solid rgba(4, 229, 229, 0.2);
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    transition: all 0.3s ease;
    height: 100%;
  }

  .moc-card:hover {
    transform: translateY(-4px);
    border-color: var(--clr-lossless-accent--brightest);
    box-shadow: 0 12px 32px rgba(4, 229, 229, 0.3);
  }

  .moc-card-image {
    width: 100%;
    height: 200px;
    background-size: cover;
    background-position: center;
    background-color: rgba(4, 229, 229, 0.1);
  }

  .moc-card-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
  }

  .moc-card h2 {
    font-size: 1.5rem;
    color: var(--clr-lossless-accent--brightest);
    margin: 0;
  }

  .moc-description {
    color: var(--clr-lossless-primary-light);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
    opacity: 0.9;
    flex: 1;
  }

  .moc-card-stats {
    display: flex;
    gap: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-number {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--clr-lossless-accent--aquamarine);
    line-height: 1;
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--clr-lossless-primary-light);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.7;
    margin-top: 0.25rem;
  }

  .related-tags-preview {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin-top: auto;
    padding-top: 1rem;
  }

  .related-label {
    font-size: 0.75rem;
    color: var(--clr-lossless-primary-light);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.7;
  }

  .tag-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: rgba(111, 255, 214, 0.1);
    border: 1px solid rgba(111, 255, 214, 0.3);
    border-radius: 12px;
    font-size: 0.75rem;
    color: var(--clr-lossless-accent--aquamarine);
    font-weight: 500;
  }

  /* Empty State */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    text-align: center;
    color: var(--clr-lossless-primary-light);
  }

  .empty-state svg {
    opacity: 0.3;
    margin-bottom: 1.5rem;
  }

  .empty-state h2 {
    font-size: 1.5rem;
    color: var(--clr-lossless-accent--brightest);
    margin: 0 0 0.75rem 0;
  }

  .empty-state p {
    font-size: 1rem;
    opacity: 0.8;
    margin: 0;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .moc-grid {
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    }
  }

  @media (max-width: 768px) {
    .moc-index-page {
      padding: 1rem;
    }

    .moc-index-header h1 {
      font-size: 2rem;
    }

    .moc-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .moc-stats {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
