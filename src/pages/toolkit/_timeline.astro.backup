---
/**
 * /toolkit/timeline.astro — Unified Timeline of Tool Additions and Modifications
 *
 * Single page with tabs to switch between yearly, monthly, and weekly views
 * Shows when tools were added (date_created) and modified (date_modified)
 * Displays all tools from both 'tooling' and 'vertical-toolkits' collections
 */
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';

export const prerender = true;

// Fetch all tools from both collections
const toolingEntries = await getCollection('tooling');
const verticalToolkitsEntries = await getCollection('vertical-toolkits');
const allTools = [...toolingEntries, ...verticalToolkitsEntries];

// Helper to parse dates
function parseDate(dateValue: any): Date | null {
  if (!dateValue) return null;
  if (dateValue instanceof Date) return dateValue;
  try {
    return new Date(dateValue);
  } catch {
    return null;
  }
}

// Helper functions for grouping
function getYear(date: Date | null): number | null {
  return date ? date.getFullYear() : null;
}

function getYearMonth(date: Date | null): string | null {
  if (!date) return null;
  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
}

function getWeekKey(date: Date): string {
  const startOfWeek = getStartOfWeek(date);
  return `${startOfWeek.getFullYear()}-W${String(getWeekNumber(startOfWeek)).padStart(2, '0')}`;
}

function getStartOfWeek(date: Date): Date {
  const d = new Date(date);
  const day = d.getDay();
  const diff = d.getDate() - day;
  return new Date(d.setDate(diff));
}

function getWeekNumber(date: Date): number {
  const d = new Date(Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()));
  const dayNum = d.getUTCDay() || 7;
  d.setUTCDate(d.getUTCDate() + 4 - dayNum);
  const yearStart = new Date(Date.UTC(d.getUTCFullYear(), 0, 1));
  return Math.ceil((((d.getTime() - yearStart.getTime()) / 86400000) + 1) / 7);
}

function formatWeekRange(weekStart: Date): string {
  const weekEnd = new Date(weekStart);
  weekEnd.setDate(weekEnd.getDate() + 6);
  const startMonth = weekStart.toLocaleDateString('en-US', { month: 'short' });
  const endMonth = weekEnd.toLocaleDateString('en-US', { month: 'short' });
  const startDay = weekStart.getDate();
  const endDay = weekEnd.getDate();
  const year = weekStart.getFullYear();
  if (startMonth === endMonth) {
    return `${startMonth} ${startDay}-${endDay}, ${year}`;
  } else {
    return `${startMonth} ${startDay} - ${endMonth} ${endDay}, ${year}`;
  }
}

const monthNames = ['January', 'February', 'March', 'April', 'May', 'June',
                    'July', 'August', 'September', 'October', 'November', 'December'];

// Build tool data structure
const toolsList = allTools.map(tool => ({
  title: tool.data.title || tool.data.og_title || tool.id.split('/').pop()?.replace('.md', '') || 'Untitled',
  id: tool.id,
  url: tool.data.url,
  dateCreated: parseDate(tool.data.date_created),
  dateModified: parseDate(tool.data.date_modified)
}));

// Group by year
const yearMap = new Map();
toolsList.forEach(tool => {
  if (tool.dateCreated) {
    const year = getYear(tool.dateCreated)!;
    if (!yearMap.has(year)) yearMap.set(year, { year, created: [], modified: [] });
    yearMap.get(year)!.created.push(tool);
  }
  if (tool.dateModified) {
    const modYear = getYear(tool.dateModified)!;
    const createdYear = tool.dateCreated ? getYear(tool.dateCreated) : null;
    if (!createdYear || modYear !== createdYear) {
      if (!yearMap.has(modYear)) yearMap.set(modYear, { year: modYear, created: [], modified: [] });
      yearMap.get(modYear)!.modified.push(tool);
    }
  }
});
const yearlyData = Array.from(yearMap.values()).sort((a, b) => b.year - a.year);
yearlyData.forEach(y => {
  y.created.sort((a, b) => b.dateCreated.getTime() - a.dateCreated.getTime());
  y.modified.sort((a, b) => b.dateModified.getTime() - a.dateModified.getTime());
});

// Group by month
const monthMap = new Map();
toolsList.forEach(tool => {
  if (tool.dateCreated) {
    const yearMonth = getYearMonth(tool.dateCreated)!;
    if (!monthMap.has(yearMonth)) {
      monthMap.set(yearMonth, {
        yearMonth, year: tool.dateCreated.getFullYear(),
        month: tool.dateCreated.getMonth(), monthName: monthNames[tool.dateCreated.getMonth()],
        created: [], modified: []
      });
    }
    monthMap.get(yearMonth)!.created.push(tool);
  }
  if (tool.dateModified) {
    const modYearMonth = getYearMonth(tool.dateModified)!;
    const createdYearMonth = tool.dateCreated ? getYearMonth(tool.dateCreated) : null;
    if (!createdYearMonth || modYearMonth !== createdYearMonth) {
      if (!monthMap.has(modYearMonth)) {
        monthMap.set(modYearMonth, {
          yearMonth: modYearMonth, year: tool.dateModified.getFullYear(),
          month: tool.dateModified.getMonth(), monthName: monthNames[tool.dateModified.getMonth()],
          created: [], modified: []
        });
      }
      monthMap.get(modYearMonth)!.modified.push(tool);
    }
  }
});
const monthlyData = Array.from(monthMap.values()).sort((a, b) => b.yearMonth.localeCompare(a.yearMonth));
monthlyData.forEach(m => {
  m.created.sort((a, b) => b.dateCreated.getTime() - a.dateCreated.getTime());
  m.modified.sort((a, b) => b.dateModified.getTime() - a.dateModified.getTime());
});

// Group by week
const weekMap = new Map();
toolsList.forEach(tool => {
  if (tool.dateCreated) {
    const weekKey = getWeekKey(tool.dateCreated);
    if (!weekMap.has(weekKey)) {
      const weekStart = getStartOfWeek(tool.dateCreated);
      weekMap.set(weekKey, {
        weekKey, weekStart, weekRange: formatWeekRange(weekStart), created: [], modified: []
      });
    }
    weekMap.get(weekKey)!.created.push(tool);
  }
  if (tool.dateModified) {
    const modWeekKey = getWeekKey(tool.dateModified);
    const createdWeekKey = tool.dateCreated ? getWeekKey(tool.dateCreated) : null;
    if (!createdWeekKey || modWeekKey !== createdWeekKey) {
      if (!weekMap.has(modWeekKey)) {
        const weekStart = getStartOfWeek(tool.dateModified);
        weekMap.set(modWeekKey, {
          weekKey: modWeekKey, weekStart, weekRange: formatWeekRange(weekStart), created: [], modified: []
        });
      }
      weekMap.get(modWeekKey)!.modified.push(tool);
    }
  }
});
const weeklyData = Array.from(weekMap.values()).sort((a, b) => b.weekStart.getTime() - a.weekStart.getTime());
weeklyData.forEach(w => {
  w.created.sort((a, b) => b.dateCreated.getTime() - a.dateCreated.getTime());
  w.modified.sort((a, b) => b.dateModified.getTime() - a.dateModified.getTime());
});

const totalTools = allTools.length;
const earliestDate = toolsList.map(t => t.dateCreated).filter(d => d !== null).sort((a, b) => a!.getTime() - b!.getTime())[0];
---

<Layout title="Toolkit Timeline">
  <div class="timeline-page">
    <header class="timeline-header">
      <h1>Toolkit Timeline</h1>
      <div class="stats">
        <p><strong>{totalTools}</strong> total tools tracked</p>
        <p>Since <strong>{earliestDate ? earliestDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long' }) : 'unknown'}</strong></p>
      </div>
      <nav class="timeline-nav">
        <button class="view-btn active" data-view="yearly">Yearly</button>
        <button class="view-btn" data-view="monthly">Monthly</button>
        <button class="view-btn" data-view="weekly">Weekly</button>
      </nav>
    </header>

    <!-- Yearly View -->
    <div id="yearly-view" class="timeline-content">
      {yearlyData.map(yearData => (
        <section class="time-section">
          <h2 class="time-heading">{yearData.year}</h2>
          {yearData.created.length > 0 && (
            <div class="activity-group created">
              <h3><span class="badge created-badge">Created</span>{yearData.created.length} tools added</h3>
              <ul class="tool-list">
                {yearData.created.map(tool => (
                  <li class="tool-item">
                    <span class="tool-date">{tool.dateCreated.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</span>
                    <span class="tool-title">
                      {tool.url ? <a href={tool.url} target="_blank" rel="noopener noreferrer" class="tool-link">{tool.title}</a> : <span>{tool.title}</span>}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {yearData.modified.length > 0 && (
            <div class="activity-group modified">
              <h3><span class="badge modified-badge">Modified</span>{yearData.modified.length} tools updated</h3>
              <ul class="tool-list">
                {yearData.modified.map(tool => (
                  <li class="tool-item">
                    <span class="tool-date">{tool.dateModified.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</span>
                    <span class="tool-title">
                      {tool.url ? <a href={tool.url} target="_blank" rel="noopener noreferrer" class="tool-link">{tool.title}</a> : <span>{tool.title}</span>}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </section>
      ))}
    </div>

    <!-- Monthly View -->
    <div id="monthly-view" class="timeline-content" style="display: none;">
      {monthlyData.map(monthData => (
        <section class="time-section summary">
          <div class="time-header">
            <h2 class="time-heading">{monthData.monthName} {monthData.year}</h2>
            <div class="count-summary">
              {monthData.created.length > 0 && (
                <div class="count-item created">
                  <span class="count-number">{monthData.created.length}</span>
                  <span class="count-label">Created</span>
                </div>
              )}
              {monthData.modified.length > 0 && (
                <div class="count-item modified">
                  <span class="count-number">{monthData.modified.length}</span>
                  <span class="count-label">Modified</span>
                </div>
              )}
            </div>
          </div>
        </section>
      ))}
    </div>

    <!-- Weekly View -->
    <div id="weekly-view" class="timeline-content" style="display: none;">
      {weeklyData.map(weekData => (
        <section class="time-section summary">
          <div class="time-header">
            <h2 class="time-heading">{weekData.weekRange}</h2>
            <div class="count-summary">
              {weekData.created.length > 0 && (
                <div class="count-item created">
                  <span class="count-number">{weekData.created.length}</span>
                  <span class="count-label">Created</span>
                </div>
              )}
              {weekData.modified.length > 0 && (
                <div class="count-item modified">
                  <span class="count-number">{weekData.modified.length}</span>
                  <span class="count-label">Modified</span>
                </div>
              )}
            </div>
          </div>
        </section>
      ))}
    </div>
  </div>

  <script>
    // View switching logic
    const viewButtons = document.querySelectorAll('.view-btn');
    const views = {
      'yearly': document.getElementById('yearly-view'),
      'monthly': document.getElementById('monthly-view'),
      'weekly': document.getElementById('weekly-view')
    };

    viewButtons.forEach(button => {
      button.addEventListener('click', () => {
        const targetView = button.getAttribute('data-view');

        // Update active button
        viewButtons.forEach(btn => btn.classList.remove('active'));
        button.classList.add('active');

        // Show target view, hide others
        Object.keys(views).forEach(viewName => {
          if (viewName === targetView) {
            views[viewName].style.display = 'block';
          } else {
            views[viewName].style.display = 'none';
          }
        });
      });
    });
  </script>
</Layout>

<style>
  .timeline-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .timeline-header {
    margin-bottom: 3rem;
    border-bottom: 2px solid var(--clr-lossless-accent--brightest, #04e5e5);
    padding-bottom: 2rem;
  }

  .timeline-header h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    color: var(--clr-lossless-primary-light, #f1f5f9);
  }

  .stats {
    margin: 1rem 0;
    display: flex;
    gap: 2rem;
    font-size: 1.1rem;
    color: var(--clr-lossless-primary-light, #cbd5e1);
  }

  .timeline-nav {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .view-btn {
    padding: 0.5rem 1rem;
    border-radius: 6px;
    border: none;
    cursor: pointer;
    color: var(--clr-lossless-primary-light, #f1f5f9);
    background: rgba(255, 255, 255, 0.05);
    transition: all 0.2s;
    font-size: 1rem;
    font-family: inherit;
  }

  .view-btn:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .view-btn.active {
    background: var(--clr-lossless-accent--brightest, #04e5e5);
    color: var(--bastille, #19141D);
    font-weight: 600;
  }

  .time-section {
    margin-bottom: 2.5rem;
    background: rgba(255, 255, 255, 0.03);
    padding: 1.5rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .time-section.summary {
    margin-bottom: 1rem;
    padding: 1rem 1.5rem;
  }

  .time-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }

  .time-heading {
    font-size: 1.75rem;
    margin-bottom: 1.25rem;
    color: var(--clr-lossless-accent--brightest, #04e5e5);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 0.5rem;
  }

  .time-section.summary .time-heading {
    margin-bottom: 0;
    border-bottom: none;
    padding-bottom: 0;
    font-size: 1.35rem;
  }

  .count-summary {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .count-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.75rem 1.25rem;
    border-radius: 8px;
    min-width: 100px;
  }

  .count-item.created {
    background: rgba(34, 197, 94, 0.15);
    border: 1px solid rgba(34, 197, 94, 0.3);
  }

  .count-item.modified {
    background: rgba(59, 130, 246, 0.15);
    border: 1px solid rgba(59, 130, 246, 0.3);
  }

  .count-number {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 0.25rem;
  }

  .count-item.created .count-number {
    color: #86efac;
  }

  .count-item.modified .count-number {
    color: #93c5fd;
  }

  .count-label {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
    color: var(--clr-lossless-primary-light, #94a3b8);
  }

  .activity-group {
    margin-bottom: 1.5rem;
  }

  .activity-group:last-child {
    margin-bottom: 0;
  }

  .activity-group h3 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    font-size: 1.1rem;
    color: var(--clr-lossless-primary-light, #e2e8f0);
  }

  .badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .created-badge {
    background: rgba(34, 197, 94, 0.2);
    color: #86efac;
  }

  .modified-badge {
    background: rgba(59, 130, 246, 0.2);
    color: #93c5fd;
  }

  .tool-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tool-item {
    display: flex;
    gap: 1rem;
    padding: 0.75rem 1rem;
    margin-bottom: 0.5rem;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 6px;
    border-left: 3px solid transparent;
    transition: all 0.2s;
  }

  .tool-item:hover {
    background: rgba(255, 255, 255, 0.06);
    border-left-color: var(--clr-lossless-accent--brightest, #04e5e5);
  }

  .tool-date {
    flex-shrink: 0;
    width: 120px;
    color: var(--clr-lossless-primary-light, #94a3b8);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .tool-title {
    flex-grow: 1;
    color: var(--clr-lossless-primary-light, #f1f5f9);
  }

  .tool-link {
    color: var(--clr-lossless-accent--brightest, #04e5e5);
    text-decoration: none;
    transition: color 0.2s;
  }

  .tool-link:hover {
    color: var(--clr-lossless-accent--aquamarine, #6FFFD6);
    text-decoration: underline;
  }

  .pagination-note {
    margin-top: 2rem;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 8px;
    text-align: center;
    color: var(--clr-lossless-primary-light, #94a3b8);
    font-size: 0.95rem;
  }

  @media (max-width: 768px) {
    .timeline-page {
      padding: 1rem;
    }

    .timeline-header h1 {
      font-size: 2rem;
    }

    .stats {
      flex-direction: column;
      gap: 0.5rem;
    }

    .time-section {
      padding: 1rem;
    }

    .time-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .count-summary {
      width: 100%;
      justify-content: space-around;
    }

    .count-item {
      min-width: auto;
      flex: 1;
      padding: 0.5rem 0.75rem;
    }

    .count-number {
      font-size: 1.5rem;
    }

    .tool-item {
      flex-direction: column;
      gap: 0.25rem;
    }

    .tool-date {
      width: auto;
      font-size: 0.75rem;
    }
  }
</style>
