---
import Layout from '../../../layouts/Layout.astro';
import AlternatingSideImage from '../../../components/basics/messages/AlternatingSideImage.astro';
import ThinGradientBleedSeparator from '../../../components/basics/separators/ThinGradientBleedSeparator.astro';

export const prerender = true;
---

<Layout title="Content Farm - a suite of Obsidian Plugins by The Lossless Group">
  <main class="main-content">
    <div class="container">
      <div class="content-farm-header">
        <div class="header-content">
          <div class="header-main">
            <div class="header-icon">
              <img src="/visuals/Tooling-Trademarks/app-icons/appIcon__Obsidian.svg" alt="Obsidian Icon" class="obsidian-icon" />
              <img src="/visuals/appIcon__Content-Farm.svg" alt="Content Farm Icon" class="content-farm-icon" />
            </div>
            <div class="header-text">
              <h1 class="page-title">Content Farm: a Suite of Plugins for Obsidian</h1>
              <p class="page-subtitle">Streamlined content creation and data preparation for AI-powered workflows</p>
            </div>
          </div>
          <div class="header-actions">
            <a href="/content-farm/" class="splash-cta">
              <span class="splash-icon-wrap">
                <img src="/visuals/appIcon__GitHub--Lightest.svg" alt="GitHub" class="splash-icon" />
              </span>
              <span>Visit the Content Farm Splash Page</span>
            </a>
            <a href="https://buymeacoffee.com/losslessgroup" target="_blank" rel="noopener noreferrer" class="coffee-cta" aria-label="Support Lossless Group on Buy Me a Coffee">
              <span class="coffee-link">
                <img src="/visuals/favicon__BuyMeACoffee.svg" alt="" class="coffee-icon" />
              </span>
              <span class="coffee-text">Support our work on Buy Me a Coffee. Even $5 gives good signal.</span>
            </a>
          </div>
        </div>
      </div>
      
      <ThinGradientBleedSeparator />
      
      <div class="content-section">
        <AlternatingSideImage 
          jsonPath="messages/projectContentFarm.json"
          classes="content-farm-features"
        />
      </div>
    </div>
  </main>
</Layout>

<style>
  .main-content {
    min-height: 100vh;
    padding: 2rem 0;
  }
  
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }
  
  .content-farm-header {
    margin-bottom: 3rem;
    padding: 2rem 0;
  }
  
  .header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
  }

  .header-main {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex: 1 1 auto;
    min-width: 0;
  }
  
  .header-icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .obsidian-icon {
    width: 72px;
    height: 72px;
    object-fit: contain;
  }
  
  .content-farm-icon {
    width: 96px;
    height: 96px;
    object-fit: contain;
  }
  
  .header-text {
    flex: 1;
  }

  .header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
    flex-wrap: wrap;
    flex: 0 0 440px;
    max-width: 440px;
  }

  .splash-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 0.75rem 1rem;
    border-radius: 999px;
    background: rgba(4, 229, 229, 0.035);
    border: 1px solid rgba(4, 229, 229, 0.16);
    color: var(--clr-lossless-accent--brightest, #04e5e5);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }

  .splash-cta:hover {
    transform: translateY(-2px);
    background: rgba(4, 229, 229, 0.07);
    border-color: rgba(4, 229, 229, 0.28);
  }

  .splash-icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    opacity: 0.74;
  }

  .splash-icon {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .coffee-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    max-width: 440px;
    color: #d1d5db;
    text-decoration: none;
  }

  .coffee-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 999px;
    background: rgba(255, 221, 0, 0.12);
    border: 1px solid rgba(255, 221, 0, 0.35);
    color: #ffdd00;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
    flex-shrink: 0;
  }

  .coffee-cta:hover .coffee-link {
    transform: translateY(-2px) scale(1.06);
    background: rgba(255, 221, 0, 0.18);
    border-color: rgba(255, 221, 0, 0.55);
  }

  .coffee-icon {
    display: block;
    width: 42px;
    height: 42px;
    object-fit: contain;
  }

  .coffee-text {
    font-size: 0.9rem;
    line-height: 1.45;
    color: #9ca3af;
    max-width: 270px;
    text-wrap: balance;
  }

  .coffee-cta:hover .coffee-text {
    color: #d1d5db;
  }
  
  .page-title {
    font-size: 3rem;
    font-weight: 700;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-align: left;
  }
  
  .page-subtitle {
    font-size: 1.25rem;
    color: #6b7280;
    line-height: 1.6;
    text-align: left;
    margin: 0;
  }
  
  .content-section {
    margin: 4rem 0;
  }
  
  /* Mobile responsiveness */
  @media (max-width: 768px) {
    .header-content {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }

    .header-main {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }

    .header-actions {
      width: 100%;
      justify-content: flex-start;
    }

    .splash-cta {
      max-width: 100%;
    }

    .coffee-cta {
      max-width: 100%;
    }

    .coffee-link {
      width: 56px;
      height: 56px;
    }

    .coffee-icon {
      width: 36px;
      height: 36px;
    }
    
    .obsidian-icon {
      width: 56px;
      height: 56px;
    }
    
    .content-farm-icon {
      width: 72px;
      height: 72px;
    }
    
    .page-title {
      font-size: 2rem;
    }
    
    .page-subtitle {
      font-size: 1.1rem;
    }
    
    .content-farm-header {
      margin-bottom: 2rem;
      padding: 1rem 0;
    }
    
    .content-section {
      margin: 2rem 0;
    }
  }
  
  /* Ensure proper spacing for the AlternatingSideImage component */
  :global(.content-farm-features) {
    margin-top: 2rem;
  }
</style>