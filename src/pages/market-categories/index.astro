---
// Market Categories collection page
// Mirrors /market-map/it, over the profiles in concepts/Market-Categories

import MagazineIndexLayout from '@layouts/MagazineIndexLayout.astro';
import { marketCategoryArticles } from '../../utils/marketCategories';
import Hero from '../../components/basics/Hero.astro';
import AnimationWrapper from '../../components/basics/AnimationWrapper.astro';

const collectionConfig = {
  title: 'Market Categories',
  subtitle: 'Category Profiles & Snapshots',
  description: 'What each market category is, why now, who plays in it, and where it is heading.'
};

const articles = await marketCategoryArticles();
---

<MagazineIndexLayout
  title={collectionConfig.title}
  description={collectionConfig.description}
  articles={articles}
  collectionDisplayName={collectionConfig.title}
>
  <div slot="hero-content" style="position: relative;">
    <AnimationWrapper>
      <Hero
        title={collectionConfig.title}
        subtitle={collectionConfig.subtitle}
        description={collectionConfig.description}
        alignment="center"
        fullBleed={false}
        animate={true}
      />
    </AnimationWrapper>
  </div>
</MagazineIndexLayout>
