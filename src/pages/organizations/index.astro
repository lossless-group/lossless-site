---
/**
 * /organizations/index.astro — Index page for the organizations collection.
 *
 * Same building blocks as /content-areas: FolderTabs for folder filtering with live counts and
 * a word total; organizations with an og_image render as ToolCards (listed first, as in CardGrid),
 * the rest as CollectionPreviewCard with word count and version.
 * Name is title → filename; og_title is a tagline shown under the name, never the title.
 */
import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getReferenceSlug } from '@utils/slugify';
import { countWordsInMarkdown } from '@utils/fileWordCount';
import { originalSegments, getDisplayTitle, folderLabel } from '@utils/collectionEntryDisplay';
import FolderTabs, { type FolderTab } from '@components/reference/FolderTabs.astro';
import CollectionPreviewCard from '@components/reference/CollectionPreviewCard.astro';
import ToolCard from '@components/tool-components/ToolCard.astro';
import WordCountDisplay from '@components/basics/WordCountDisplay.astro';

const BASE = 'organizations';

const orgEntries = await getCollection('organizations');

const asString = (v: unknown) => (typeof v === 'string' && v.trim() ? v.trim() : undefined);
const asTags = (v: unknown): string[] =>
  Array.isArray(v) ? v.filter((t): t is string => typeof t === 'string') : typeof v === 'string' ? [v] : [];

const items = orgEntries.map(entry => {
  const segs = originalSegments(entry, BASE);
  const nested = segs.length > 1;
  const title = getDisplayTitle({ ...entry, data: { ...entry.data, og_title: undefined } }, BASE);
  const ogTitle = asString(entry.data?.og_title);
  const ogImage = asString(entry.data?.og_image);
  const rawVersion = entry.data?.at_semantic_version;
  return {
    entry,
    folder: nested ? entry.id.split('/')[0] : 'root',
    folderLabel: nested ? folderLabel(segs[0]) : '',
    title,
    subtitle: ogTitle && ogTitle !== title ? ogTitle : undefined,
    href: `/organizations/${getReferenceSlug(entry.id)}`,
    words: countWordsInMarkdown(entry.body || ''),
    version: rawVersion != null && String(rawVersion).trim() ? String(rawVersion).trim() : undefined,
    image: ogImage && /^https?:\/\//.test(ogImage) ? ogImage : undefined,
  };
});

// Image cards first (as in CardGrid), then by name
items.sort((a, b) => Number(!!b.image) - Number(!!a.image) || a.title.localeCompare(b.title));

const totalWords = items.reduce((sum, i) => sum + i.words, 0);

// Folder tabs; files at the root get "Uncategorized", listed last
const folderMap = new Map<string, FolderTab>();
for (const i of items) {
  const t = folderMap.get(i.folder) ?? { id: i.folder, label: i.folder === 'root' ? 'Uncategorized' : i.folderLabel, count: 0 };
  t.count++;
  folderMap.set(i.folder, t);
}
const levelOne = [...folderMap.values()].sort((a, b) =>
  Number(a.id === 'root') - Number(b.id === 'root') || a.label.localeCompare(b.label)
);
---

<Layout
  title="Organizations"
  description="Browse our collection of organizations, companies, and institutions"
  frontmatter={{
    title: "Organizations",
    description: "A curated collection of companies, institutions, and other organizations"
  }}
>
  <div class="orgs-container">
    <header class="orgs-header">
      <h1>Organizations</h1>
      <p class="description">
        Companies, institutions, and other organizations we've gathered.
      </p>
    </header>

    <FolderTabs
      gridId="orgs-grid"
      levelOne={levelOne}
      levelTwo={{}}
      totalCount={items.length}
      totalWords={totalWords}
      itemNoun="organizations"
    />

    <div id="orgs-grid" class="orgs-grid">
      {items.map(item => (
        <div class="orgs-item" data-area={item.folder} data-type="_root" data-words={item.words}>
          {item.image ? (
            <>
              <ToolCard
                id={item.entry.id}
                url={asString(item.entry.data?.url)}
                og_image={item.image}
                site_name={item.title}
                title={item.subtitle}
                description={asString(item.entry.data?.description)}
                og_description={asString(item.entry.data?.og_description)}
                tags={asTags(item.entry.data?.tags)}
                filename={item.title}
                detailHref={item.href}
                keepNameCase
              />
              {(item.words > 90 || item.version) && (
                <div class="orgs-item__badges">
                  <span>{item.folderLabel}</span>
                  <span class="orgs-item__stats">
                    {item.words > 90 && <WordCountDisplay count={item.words} className="text-gray-400" showIcon={false} />}
                    {item.version && <span class="orgs-item__version">{item.version}</span>}
                  </span>
                </div>
              )}
            </>
          ) : (
            <CollectionPreviewCard
              href={item.href}
              title={item.title}
              subtitle={item.subtitle}
              meta={item.folderLabel || undefined}
              wordCount={item.words}
              version={item.version}
            />
          )}
        </div>
      ))}
    </div>

    <div class="empty-state" data-empty-state hidden>
      <p>No organizations found in this category.</p>
    </div>
  </div>
</Layout>

<style>
  .orgs-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem;
  }

  .orgs-header {
    margin-bottom: 1.5rem;
  }

  .orgs-header h1 {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--clr-lossless-primary-light, #fff);
    margin-bottom: 0.5rem;
  }

  .description {
    font-size: 1.125rem;
    color: var(--clr-body, rgba(255, 255, 255, 0.8));
    margin: 0;
  }

  .orgs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
    align-items: start;
  }

  .orgs-item[hidden],
  .empty-state[hidden] {
    display: none;
  }

  .orgs-item__badges {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.35rem;
    padding: 0 0.25rem;
    font-size: 0.75rem;
    color: var(--white--pure--40p, rgba(255, 255, 255, 0.4));
  }

  .orgs-item__stats {
    display: inline-flex;
    gap: 0.5rem;
    white-space: nowrap;
  }

  .orgs-item__version {
    font-size: 0.7rem;
    opacity: 0.8;
  }

  .empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--clr-body, rgba(255, 255, 255, 0.6));
  }

  @media (max-width: 768px) {
    .orgs-container { padding: 1rem; }
    .orgs-header h1 { font-size: 2rem; }
    .orgs-grid { grid-template-columns: 1fr; }
  }
</style>
