---
/**
 * /organizations/index.astro — Index page for the organizations collection.
 * Mirrors /sources/index.astro: tabbed by top-level folder with client-side filtering.
 */
import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { toProperCase, getReferenceSlug } from '@utils/slugify';

const orgEntries = await getCollection('organizations');

function getDisplayTitle(entry: any): string {
  if (entry.data?.title && String(entry.data.title).trim()) {
    return String(entry.data.title).trim();
  }
  if (entry.data?.og_title && String(entry.data.og_title).trim()) {
    return String(entry.data.og_title).trim();
  }
  const filename = entry.id.split('/').pop()?.replace(/\.md$/, '') || entry.id;
  return toProperCase(filename);
}

const entriesByFolder = new Map<string, typeof orgEntries>();
entriesByFolder.set('root', []);
for (const entry of orgEntries) {
  const parts = entry.id.split('/');
  const folder = parts.length > 1 ? parts[0] : 'root';
  if (!entriesByFolder.has(folder)) entriesByFolder.set(folder, []);
  entriesByFolder.get(folder)!.push(entry);
}

const folders = Array.from(entriesByFolder.keys()).sort((a, b) => {
  if (a === 'root') return 1;
  if (b === 'root') return -1;
  return a.localeCompare(b);
});

const processedEntries = orgEntries.map(entry => {
  const parts = entry.id.split('/');
  return {
    id: entry.id,
    slug: getReferenceSlug(entry.id),
    displayTitle: getDisplayTitle(entry),
    folder: parts.length > 1 ? parts[0] : 'root',
    url: entry.data?.url,
    tags: entry.data?.tags,
  };
}).sort((a, b) => a.displayTitle.localeCompare(b.displayTitle));

const tabConfig = folders.map(folder => ({
  id: folder,
  label: folder === 'root' ? 'Uncategorized' : toProperCase(folder),
  count: entriesByFolder.get(folder)?.length || 0
}));
---

<Layout
  title="Organizations"
  description="Browse our collection of organizations, companies, and institutions"
  frontmatter={{
    title: "Organizations",
    description: "A curated collection of companies, institutions, and other organizations"
  }}
>
  <div class="orgs-container">
    <header class="orgs-header">
      <h1>Organizations</h1>
      <p class="description">
        A collection of {orgEntries.length} companies, institutions, and other organizations we've gathered.
      </p>
    </header>

    <nav class="tab-nav" role="tablist" aria-label="Organization categories">
      <button
        class="tab-btn active"
        data-folder="all"
        role="tab"
        aria-selected="true"
        aria-controls="orgs-grid"
      >
        All <span class="count">{orgEntries.length}</span>
      </button>
      {tabConfig.map(tab => (
        <button
          class="tab-btn"
          data-folder={tab.id}
          role="tab"
          aria-selected="false"
          aria-controls="orgs-grid"
        >
          {tab.label} <span class="count">{tab.count}</span>
        </button>
      ))}
    </nav>

    <div id="orgs-grid" class="orgs-grid" role="tabpanel">
      {processedEntries.map(entry => (
        <article class="org-card" data-folder={entry.folder}>
          <a href={`/organizations/${entry.slug}`} class="org-link">
            <h3 class="org-title">{entry.displayTitle}</h3>
            {entry.folder !== 'root' && (
              <span class="org-folder">{toProperCase(entry.folder)}</span>
            )}
          </a>
        </article>
      ))}
    </div>

    <div class="empty-state" style="display: none;">
      <p>No organizations found in this category.</p>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.tab-btn');
    const cards = document.querySelectorAll('.org-card');
    const emptyState = document.querySelector('.empty-state');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const folder = tab.getAttribute('data-folder');
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        let visibleCount = 0;
        cards.forEach(card => {
          const cardFolder = card.getAttribute('data-folder');
          if (folder === 'all' || cardFolder === folder) {
            (card as HTMLElement).style.display = '';
            visibleCount++;
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
        if (emptyState) {
          (emptyState as HTMLElement).style.display = visibleCount === 0 ? 'block' : 'none';
        }
      });
    });
  });
</script>

<style>
  .orgs-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem;
  }

  .orgs-header {
    margin-bottom: 2rem;
  }

  .orgs-header h1 {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--clr-lossless-primary-light, #fff);
    margin-bottom: 0.5rem;
  }

  .description {
    font-size: 1.125rem;
    color: var(--clr-body, rgba(255, 255, 255, 0.8));
    margin: 0;
  }

  .tab-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--clr-lossless-ui-btn-border, rgba(255, 255, 255, 0.1));
  }

  .tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--clr-lossless-primary-dark, #19141D);
    border: 1px solid var(--clr-lossless-ui-btn-border, rgba(255, 255, 255, 0.1));
    border-radius: 0.5rem;
    color: var(--clr-body, rgba(255, 255, 255, 0.8));
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tab-btn:hover {
    background: var(--clr-lossless-primary-glass, rgba(255, 255, 255, 0.05));
    border-color: var(--clr-lossless-accent--brightest, rgb(4, 229, 229));
  }

  .tab-btn.active {
    background: var(--clr-lossless-accent--brightest, rgb(4, 229, 229));
    color: var(--clr-lossless-primary-dark, #19141D);
    border-color: var(--clr-lossless-accent--brightest, rgb(4, 229, 229));
  }

  .tab-btn .count {
    font-size: 0.75rem;
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.15);
  }

  .tab-btn.active .count {
    background: rgba(0, 0, 0, 0.2);
  }

  .orgs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .org-card {
    background: var(--clr-lossless-primary-dark, #19141D);
    border: 1px solid transparent;
    border-radius: 0.5rem;
    transition: all 0.2s ease;
  }

  .org-card:hover {
    background: #3a3a45;
    border-color: var(--clr-lossless-accent--brightest, rgb(4, 229, 229));
    transform: translateY(-2px);
  }

  .org-link {
    display: block;
    padding: 1rem;
    text-decoration: none;
    color: inherit;
  }

  .org-title {
    font-size: 1rem;
    font-weight: 500;
    color: var(--clr-lossless-accent--brightest, rgb(4, 229, 229));
    margin: 0 0 0.25rem 0;
    line-height: 1.4;
  }

  .org-folder {
    font-size: 0.75rem;
    color: var(--white--pure--40p, rgba(255, 255, 255, 0.4));
  }

  .empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--clr-body, rgba(255, 255, 255, 0.6));
  }

  @media (max-width: 768px) {
    .orgs-container { padding: 1rem; }
    .orgs-header h1 { font-size: 2rem; }
    .tab-nav { gap: 0.375rem; }
    .tab-btn { padding: 0.375rem 0.75rem; font-size: 0.8rem; }
    .orgs-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 480px) {
    .tab-nav { flex-direction: column; }
    .tab-btn { width: 100%; justify-content: space-between; }
  }
</style>
