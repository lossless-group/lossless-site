---
// site/src/pages/keeping-up/index.astro
// List page for "Keeping Up" — short briefings on recently-released tools, models,
// packages, and standards.
//
// Frontmatter is intentionally not hard-validated. Every field access is guarded
// so malformed entries simply render with fallbacks rather than breaking the build.

import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import Hero from '@components/basics/Hero.astro';
import AnimationWrapper from '@components/basics/AnimationWrapper.astro';
import { processEntries } from '@utils/slugify';

const entriesRaw = await getCollection('keeping-up');
const entries = processEntries(entriesRaw);

// Build the list — defensive about every frontmatter field.
const items = entries
  .map((entry) => {
    const data = (entry.data ?? {}) as Record<string, unknown>;

    // Date for sorting/display — accept either string or Date, fall back gracefully.
    const rawDate = (data.date_modified ?? data.date_created ?? data.release_date) as
      | string
      | Date
      | undefined;
    let dateIso: string | undefined;
    let dateDisplay: string | undefined;
    if (rawDate) {
      try {
        const d = rawDate instanceof Date ? rawDate : new Date(rawDate);
        if (!isNaN(d.getTime())) {
          dateIso = d.toISOString();
          dateDisplay = d.toISOString().split('T')[0];
        }
      } catch {
        // ignore — sloppy frontmatter, skip the date
      }
    }

    const tags = Array.isArray(data.tags)
      ? (data.tags as unknown[]).filter((t): t is string => typeof t === 'string')
      : typeof data.tags === 'string'
        ? [data.tags as string]
        : [];

    return {
      slug: entry.slug,
      href: `/keeping-up/${entry.slug}`,
      title: (data.title as string) || entry.data?.title || entry.id,
      lede: (data.lede as string) || (data.description as string) || '',
      dateIso,
      dateDisplay,
      tags
    };
  })
  // Sort by date descending; undated entries sink to the bottom.
  .sort((a, b) => {
    if (!a.dateIso && !b.dateIso) return 0;
    if (!a.dateIso) return 1;
    if (!b.dateIso) return -1;
    return b.dateIso.localeCompare(a.dateIso);
  });

const frontmatter = {
  title: 'Keeping Up',
  description:
    'Short briefings on recently-released tools, models, packages, and standards worth knowing about.',
  lede: 'What got released this week and whether it matters.'
};
---

<Layout frontmatter={frontmatter}>
  <AnimationWrapper>
    <Hero
      title="Keeping Up"
      subtitle="What got released this week and whether it matters"
      description="Short briefings on recently-released tools, models, packages, and standards. Skim-friendly; opinionated on relevance to our stack."
      alignment="center"
      fullBleed={false}
      animate={true}
    />
  </AnimationWrapper>

  <section class="keeping-up-section">
    <div class="keeping-up-container">
      <ul class="keeping-up-list">
        {items.map((item) => (
          <li class="keeping-up-item">
            <a href={item.href} class="keeping-up-link">
              <div class="keeping-up-row">
                {item.dateDisplay && (
                  <time class="keeping-up-date" datetime={item.dateIso}>{item.dateDisplay}</time>
                )}
                <h3 class="keeping-up-title">{item.title}</h3>
              </div>
              {item.lede && <p class="keeping-up-lede">{item.lede}</p>}
              {item.tags.length > 0 && (
                <ul class="keeping-up-tags">
                  {item.tags.map((tag) => (
                    <li class="keeping-up-tag">{tag}</li>
                  ))}
                </ul>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<style>
  .keeping-up-section {
    padding: 3rem 0;
    background: var(--clr-primary-bg);
  }

  .keeping-up-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .keeping-up-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .keeping-up-item {
    background: color-mix(
      in oklab,
      var(--clr-lossless-primary-glass),
      var(--clr-lossless-primary-dark) 95%
    );
    border: 1px solid var(--clr-lossless-ui-btn-border);
    border-radius: 0.75rem;
    transition: all 0.2s ease;
  }

  .keeping-up-item:hover {
    border-color: var(--clr-lossless-accent--brightest);
    transform: translateY(-2px);
  }

  .keeping-up-link {
    display: block;
    padding: 1.25rem 1.5rem;
    text-decoration: none;
    color: inherit;
  }

  .keeping-up-row {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .keeping-up-date {
    font-family: monospace;
    font-size: 0.875rem;
    color: var(--clr-lossless-accent--brightest);
    opacity: 0.8;
    flex-shrink: 0;
  }

  .keeping-up-title {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--clr-lossless-primary-light);
    margin: 0;
    line-height: 1.3;
  }

  .keeping-up-lede {
    margin: 0.5rem 0 0 0;
    color: var(--clr-body);
    opacity: 0.85;
    line-height: 1.5;
  }

  .keeping-up-tags {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .keeping-up-tag {
    font-size: 0.75rem;
    padding: 0.15rem 0.55rem;
    border-radius: 1rem;
    background: color-mix(in oklab, var(--clr-lossless-primary-light), transparent 85%);
    color: var(--clr-lossless-primary-light);
  }

  @media (max-width: 640px) {
    .keeping-up-container {
      padding: 0 1rem;
    }
    .keeping-up-link {
      padding: 1rem 1.25rem;
    }
  }
</style>
